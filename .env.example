# DB TOGGLE — set both to "true" to use a personal/alternate Supabase
# project (below) instead of the one above. Build-time flag: requires a
# redeploy / dev server restart to take effect. Defaults to "false".
USE_PERSONAL_SUPABASE=false
VITE_USE_PERSONAL_SUPABASE=false

PERSONAL_SUPABASE_PROJECT_ID=
PERSONAL_SUPABASE_URL=
PERSONAL_SUPABASE_PUBLISHABLE_KEY=
VITE_PERSONAL_SUPABASE_PROJECT_ID=
VITE_PERSONAL_SUPABASE_URL=
VITE_PERSONAL_SUPABASE_PUBLISHABLE_KEY=

VITE_OPENROUTER_API_KEY=

# Base URL of the deployed CaseArena engine (the Next.js app with the curated
# case library, Grok interviewer, and extraction pipeline). Server-only —
# used by generateEngineCase() in src/lib/ai.functions.ts. Not secret, but
# not VITE_-prefixed since the browser gets the redirect URL back from the
# server function rather than building it itself.
CASEARENA_ENGINE_URL=
